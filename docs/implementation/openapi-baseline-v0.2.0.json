{
  "components": {
    "schemas": {
      "Access": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "port": {
            "$ref": "#/components/schemas/PortRange"
          },
          "protocol": {
            "title": "Protocol",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination",
          "protocol",
          "port"
        ],
        "title": "Access",
        "type": "object"
      },
      "AclAnalysis": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "const": "候选路径与拟新增策略分析，非现网 ACL 状态",
            "default": "候选路径与拟新增策略分析，非现网 ACL 状态",
            "title": "Classification",
            "type": "string"
          },
          "extracted_facts": {
            "$ref": "#/components/schemas/ExtractedFacts"
          },
          "raw_analysis": {
            "title": "Raw Analysis",
            "type": "string"
          },
          "raw_config": {
            "title": "Raw Config",
            "type": "string"
          },
          "verification_summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "verified",
                "unverified",
                "review_required",
                "skipped"
              ]
            },
            "title": "Verification Summary",
            "type": "object"
          }
        },
        "required": [
          "raw_analysis",
          "raw_config",
          "extracted_facts"
        ],
        "title": "AclAnalysis",
        "type": "object"
      },
      "AclCandidateAnalysis": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "const": "LLM 候选事实影子分析，不作为合规依据",
            "default": "LLM 候选事实影子分析，不作为合规依据",
            "title": "Classification",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AclCandidateComparison"
            },
            "title": "Items",
            "type": "array"
          },
          "mode": {
            "const": "shadow",
            "default": "shadow",
            "title": "Mode",
            "type": "string"
          }
        },
        "title": "AclCandidateAnalysis",
        "type": "object"
      },
      "AclCandidateComparison": {
        "additionalProperties": false,
        "properties": {
          "deterministic": {
            "$ref": "#/components/schemas/ExtractedFacts"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "llm_candidate": {
            "$ref": "#/components/schemas/LlmAclExtractionItem"
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejection Reason"
          },
          "status": {
            "enum": [
              "agree",
              "llm_only",
              "deterministic_only",
              "conflict",
              "empty",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "status",
          "deterministic",
          "llm_candidate"
        ],
        "title": "AclCandidateComparison",
        "type": "object"
      },
      "AddressInput": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Address",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "title": "AddressInput",
        "type": "object"
      },
      "DecisionFinding": {
        "additionalProperties": false,
        "description": "One adjudication finding exposed on the item (V4-P4, additive).\n\nMirrors the reducer's ``Finding`` in frozen insertion order; the internal\npriority is not exposed. ``is_primary`` marks the single finding that\ndetermined ``reason_code`` / ``reason_type``.",
        "properties": {
          "affects_decision": {
            "default": true,
            "title": "Affects Decision",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "is_primary": {
            "default": false,
            "title": "Is Primary",
            "type": "boolean"
          },
          "reason_type": {
            "anyOf": [
              {
                "enum": [
                  "policy_violation",
                  "fact_incomplete",
                  "fact_conflict",
                  "acl_no_path",
                  "dependency_failure",
                  "risk_uncertain"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Type"
          },
          "source": {
            "enum": [
              "network",
              "rule",
              "acl",
              "semantic"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "code",
          "source"
        ],
        "title": "DecisionFinding",
        "type": "object"
      },
      "DecisionTrace": {
        "additionalProperties": false,
        "properties": {
          "deterministic_decision": {
            "enum": [
              "合规",
              "待定"
            ],
            "title": "Deterministic Decision",
            "type": "string"
          },
          "final_decision": {
            "enum": [
              "合规",
              "待定"
            ],
            "title": "Final Decision",
            "type": "string"
          },
          "final_reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Reason Code"
          },
          "semantic_effect": {
            "enum": [
              "unchanged",
              "observation_only",
              "question_only",
              "downgraded",
              "semantic_failure"
            ],
            "title": "Semantic Effect",
            "type": "string"
          },
          "semantic_finding_ids": {
            "items": {
              "type": "string"
            },
            "title": "Semantic Finding Ids",
            "type": "array"
          }
        },
        "required": [
          "deterministic_decision",
          "semantic_effect",
          "final_decision"
        ],
        "title": "DecisionTrace",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": true,
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvaluationItem": {
        "additionalProperties": true,
        "type": "object"
      },
      "EvaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "destinations": {
            "items": {
              "$ref": "#/components/schemas/AddressInput"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Destinations",
            "type": "array"
          },
          "ports": {
            "items": {
              "$ref": "#/components/schemas/PortRange"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Ports",
            "type": "array"
          },
          "protocol": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Protocol",
            "type": "string"
          },
          "request_description": {
            "default": "",
            "maxLength": 10000,
            "title": "Request Description",
            "type": "string"
          },
          "request_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Request Id",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AddressInput"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "sources",
          "destinations",
          "protocol",
          "ports"
        ],
        "title": "EvaluationRequest",
        "type": "object"
      },
      "EvaluationResponse": {
        "additionalProperties": true,
        "type": "object"
      },
      "ExtractedFacts": {
        "additionalProperties": false,
