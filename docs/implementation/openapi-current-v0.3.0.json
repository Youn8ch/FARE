      "DecisionFinding": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "source": {
            "type": "string",
            "enum": [
              "network",
              "rule",
              "semantic"
            ],
            "title": "Source"
          },
          "reason_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "policy_violation",
                  "fact_incomplete",
                  "fact_conflict",
                  "dependency_failure",
                  "risk_uncertain"
