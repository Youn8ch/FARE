              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Type"
          },
          "affects_decision": {
            "type": "boolean",
            "title": "Affects Decision",
            "default": true
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "is_primary": {
            "type": "boolean",
            "title": "Is Primary",
            "default": false
          }
