{
  "openapi": "3.1.0",
  "info": {
    "title": "FARE",
    "description": "Firewall Access Request Evaluator",
    "version": "0.3.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v2/evaluations": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Evaluate",
        "operationId": "evaluate_v2_evaluations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evaluations": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Evaluate V1 Retired",
        "description": "Retirement stub for the 0.3.x compatibility window.\n\nThe route never reaches the evaluation runtime and never restores the\nremoved schema; it only points legacy callers at /v2/evaluations. The\nroute itself is deleted in a later coordinated release.",
        "operationId": "evaluate_v1_retired_v1_evaluations_post",
        "responses": {
          "410": {
            "description": "Gone — this API version was retired in 0.3.0",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
